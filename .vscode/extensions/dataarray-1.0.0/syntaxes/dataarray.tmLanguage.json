{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DataArray",
  "scopeName": "source.dataarray",
  "fileTypes": [
    "dta"
  ],
  "firstLineMatch": "(^\\s*;.*?-\\*-.*?\\blisp\\b.*?-\\*-) # editorconfig",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#parens"
    },
    {
      "include": "#constants"
    }
  ],
  "repository": {
    "expressions": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#variables"
        },
        {
          "include": "#control"
        },
        {
          "include": "#functions"
        },
        {
          "include": "#operators"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.dataarray",
          "match": "(\\$)(?x:[a-zA-z0-9]*)|\\#|(\\*)(?i:trace-output|terminal-io|suppress-series-warnings|standard-output|standard-input|readtable|read-suppress|read-eval|read-default-float-format|read-base|random-state|query-io|print-right-margin|print-readably|print-radix|print-pretty|print-pprint-dispatch|print-miser-width|print-lines|print-level|print-length|print-gensym|print-escape|print-circle|print-case|print-base|print-array|package|modules|macroexpand-hook|load-verbose|load-truename|load-print|load-pathname|gensym-counter|features|evalhook|error-output|default-pathname-defaults|debugger-hook|debug-io|compile-verbose|compile-print|compile-file-truename|compile-file-pathname|break-on-warnings|break-on-signals|applyhook)(\\*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.begin.dataarray"
            },
            "2": {
              "name": "punctuation.definition.variable.end.dataarray"
            }
          }
        },
        {
          "name": "variable.other.global.dataarray",
          "match": "(\\*)(\\S*)(\\*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.variable.begin.dataarray"
            },
            "3": {
              "name": "punctuation.definition.variable.end.dataarray"
            }
          }
        }
      ]
    },
    "control": {
      "name": "keyword.control.dataarray",
      "match": "\\b(with|while|when|unless|typecase|to|thereis|then|get_symbol|foreach_active_player|is_modifier_active|return-from name|return|repeat|prog*|prog|never|named|maplist|mapl|mapcon|mapcar|mapcan|mapc|loop|let|initially|if|if_else|unless|while|do|delete|object|exists|ui|from|for|finally|etypecase|else|dotimes|dolist|doing|do*|do|ctypecase|cond|case|block|as|always)\\b"
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function.dataarray",
          "match": "\\b((defun|defmethod|defmacro))\\b\\s+([\\w\\-!?<>]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.dataarray"
            },
            "2": {
              "name": "entity.name.function.dataarray"
            }
          }
        },
        {
          "name": "support.function.string.dataarray",
          "match": "\\b(sprintf|sprint|printf|print|strcat|strlen|str_elem|substr|tolower|toupper|strieq|has_substr|has_any_substr|find_substr|search_replace|basename|dirname|startswith)\\b"
        },
        {
          "name": "support.function.array.dataarray",
          "match": "\\b(array|size|elem|last_elem|set_elem|insert_elem|insert_elems|remove_elem|push_back|flatten|sort|resize|get_elem|find_elem|array_to_string|print_array)\\b"
        },
        {
          "name": "support.function.math.dataarray",
          "match": "\\b(\\+|\\-|\\*|/|mod|pow|sqrt|abs|min|max|mean|clamp|clamp_eq|round|floor|ceil|db_to_ratio|ratio_to_db|dist|interp|reverse_interp)\\b"
        },
        {
          "name": "support.function.logic.dataarray",
          "match": "\\b(==|!=|<=|<|>=|>|!|&&|\\|\\||\\^\\^|if|if_else|unless|cond|switch)\\b"
        },
        {
          "name": "support.function.bitwise.dataarray",
          "match": "\\b(&|\\||\\^|~|&=|\\|=|mask_eq|lowest_bit|count_bits)\\b"
        },
        {
          "name": "support.function.type.dataarray",
          "match": "\\b(type|int|symbol|char|asc|object|localize|localize_separated_int|localize_float|sync_reload_locale|get_type)\\b"
        },
        {
          "name": "support.function.control.dataarray",
          "match": "\\b(do|while|foreach|foreach_int|var|set_var|set|quote|quasiquote|unquote|eval|with)\\b"
        },
        {
          "name": "support.function.file.dataarray",
          "match": "\\b(read_file|write_file|write_string_to_file|file_exists|file_mkdir|file_read_only|run|file_list|file_list_paths)\\b"
        },
        {
          "name": "support.function.object.dataarray",
          "match": "\\b(new|delete|find|find_obj|find_exists|handle|handle_ret|handle_type|handle_type_ret|export|exists|contains|object_list|find_obj|replace_object|next_name|merge_dirs|set_this|with)\\b"
        },
        {
          "name": "support.function.debug.dataarray",
          "match": "\\b(warn|notify|notify_once|fail|assert|time|print_stack|print_unused|disable_notify|filter_notify|memory_usage_report|memory_alloc_report)\\b"
        },
        {
          "name": "support.function.random.dataarray",
          "match": "\\b(random_int|random_float|random_elem|random|random_seed|random_sort)\\b"
        },
        {
          "name": "support.function.misc.dataarray",
          "match": "\\b(inc|dec|macro_elem|macro_size|get_date_time|exit|zerop|yes-or-no-p|y-or-n-p|write-to-string|write-string)\\b"
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.dataarray",
      "patterns": [
        {
          "name": "keyword.operator.assignment.dataarray",
          "match": "\\!|/\\=|\\=\\=|&&|\\|\\||\\>\\=|\\<\\=|\\=|\\>|\\<"
        },
        {
          "name": "keyword.operator.arithmetic.dataarray",
          "match": "\\+\\=|\\-\\=|\\*\\=|/\\=|\\b(?i:mod|rem|incf|decf)\\b"
        },
        {
          "name": "keyword.operator.logical.dataarray",
          "match": "\\b(?i:and|or|not)\\b"
        },
        {
          "name": "keyword.operator.bitwise.dataarray",
          "match": "\\b(?i:logand|logior|logxor|lognor|logeqv)\\b"
        }
      ]
    },
    "parens": {
      "name": "meta.group.dataarray",
      "begin": "(\\(|\\{|\\[)([0-9a-zA-z][a-zA-Z0-9_]*)?",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.group.begin.dataarray"
        },
        "2": {
          "name": "entity.name.tag.dataarray"
        }
      },
      "end": "(\\)|\\}|\\])",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.group.end.dataarray"
        }
      },
      "patterns": [
        {
          "include": "#expressions"
        },
        {
          "include": "#parens"
        },
        {
          "name": "invalid.illegal.stray-bracket-end.dataarray",
          "match": "\\)|\\}|\\]"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.dataarray",
          "match": "\\b(null|t|SCROLL_SELECT_MSG|kDataUnhandled|beatmatch|SongSelectPanel|MultiSelectListPanel|BandScreen|GHScreen|UIScreen|GamePanel|OvershellPanel|BandStorePanel|MainHubPanel|profile_mgr|UILabel|UIButton|UIPanel|Mesh|Mat|Group|Tex|GHPanel|UIComponent|BandList|UISlider|memcardmgr|song_provider|gamemode|gamecfg|modifier_mgr|(\\#)include|(\\#)else|define|(\\#)define|(\\#)merge|(\\#)ifdef|(\\#)ifndef|(\\#)endif|FOCUS_MSG|UI_CHANGED_MSG|TRANSITION_COMPLETE_MSG|SELECT_DONE_MSG|BUTTON_DOWN_MSG|SCROLL_MSG|SELECT_MSG|BUTTON_UP_MSG|single-float-negative-epsilon|single-float-epsilon|short-float-negative-epsilon|short-float-epsilon|pi|nil|multiple-values-limit|most-positive-single-float|most-positive-short-float|most-positive-long-float|most-positive-fixnum|most-positive-double-float|most-negative-single-float|most-negative-short-float|most-negative-long-float|most-negative-fixnum|most-negative-double-float|long-float-negative-epsilon|long-float-epsilon|least-positive-single-float|least-positive-short-float|least-positive-normalized-single-float|least-positive-normalized-short-float|least-positive-normalized-long-float|least-positive-normalized-double-float|least-positive-long-float|least-positive-double-float|least-negative-single-float|least-negative-short-float|least-negative-normalized-single-float|least-negative-normalized-short-float|least-negative-normalized-long-float|least-negative-normalized-double-float|least-negative-long-float|least-negative-double-float|lambda-parameters-limit|lambda-list-keywords|internal-time-units-per-second|double-float-negative-epsilon|double-float-epsilon|char-super-bit|char-meta-bit|char-hyper-bit|char-font-limit|char-control-bit|char-code-limit|char-bits-limit|call-arguments-limit|array-total-size-limit|array-rank-limit|array-dimension-limit)\b"
        },
        {
          "name": "constant.language.dataarray",
          "match": "(#)(\\w|[\\\\+-=<>''\"&#])+",
          "captures": {
            "1": {
              "name": "punctuation.definition.keyword.dataarray"
            }
          }
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.dataarray",
      "match": "\\b((0(x|X)\\h*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)(l|ul|u|f|ll|ull)?\\b"
    },
    "strings": {
      "name": "string.quoted.double.dataarray",
      "begin": "\"",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.dataarray"
        }
      },
      "end": "\"",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.dataarray"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.dataarray",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.dataarray",
          "match": "\\%%"
        },
        {
          "name": "variable.parameter",
          "match": "\\%[0-9a-z\\.]+"
        },
        {
          "name": "entity.name.tag",
          "begin": "<(alt|sup)",
          "end": ">"
        }
      ]
    },
    "comments": {
      "name": "comment.line.semicolon.dataarray",
      "begin": "(;).*",
      "end": "\n?",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.comment.dataarray"
        }
      }
    }
  }
}